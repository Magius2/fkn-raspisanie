<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="widget_bg_light">#F4F2F8</color>
    <style name="WidgetText.Title">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/widget_text_secondary_dark</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="WidgetText.Time">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/widget_text_primary_dark</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="WidgetText.TimeAccent">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/indigo_light</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="WidgetText.Line">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/widget_text_primary_dark</item>
    </style>
    <style name="WidgetText.Small">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/widget_text_secondary_dark</item>
    </style>
    <style name="WidgetText.Big">
        <item name="android:textSize">34sp</item>
        <item name="android:textColor">@color/indigo_light</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Theme.FknSchedule" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/indigo_light</item>
        <item name="colorOnPrimary">@color/badge_text</item>
        <item name="colorSecondary">@color/indigo</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
