<?xml version="1.0" encoding="utf-8"?>
<!-- Фон виджетов (светлая тема). RemoteViews не умеет ?attr — только конкретные
     цвета, тёмный вариант живёт в drawable-night/widget_bg.xml. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/widget_bg_light" />
    <corners android:radius="16dp" />
    <stroke android:width="1dp" android:color="#E3E0EC" />
</shape>
