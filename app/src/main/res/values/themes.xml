<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FknSchedule" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/indigo</item>
        <item name="colorOnPrimary">@color/badge_text</item>
        <item name="colorSecondary">@color/indigo_light</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="TextAppearance.Toolbar" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">?android:textColorPrimary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Текст виджетов: RemoteViews не умеет ?attr, поэтому значения
         переопределяются в values-night. -->
    <style name="WidgetText" parent="">
        <item name="android:textColor">@color/widget_text_primary_light</item>
    </style>
    <style name="WidgetText.Title">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/widget_text_secondary_light</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="WidgetText.Time">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/widget_text_primary_light</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="WidgetText.TimeAccent">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/indigo</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="WidgetText.Line">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/widget_text_primary_light</item>
    </style>
    <style name="WidgetText.Small">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/widget_text_secondary_light</item>
    </style>
    <style name="WidgetText.Big">
        <item name="android:textSize">34sp</item>
        <item name="android:textColor">@color/indigo</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
